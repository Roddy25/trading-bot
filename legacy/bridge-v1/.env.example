# ============================================================
# Tradify bridge — environment configuration
# Copy to `.env` and fill in. NEVER commit the real .env.
# ============================================================

# --- server ---
PORT=8787
# Comma-separated origins allowed to call this bridge.
# The published site origin, plus localhost for local testing.
ALLOWED_ORIGINS=http://localhost:8787,http://localhost:3000,http://127.0.0.1:5500

# ============================================================
# MetaTrader 5
# ------------------------------------------------------------
# Node cannot talk to MT5 directly. Run a small local MT5 bridge
# that wraps the official Python `MetaTrader5` package and exposes
# HTTP endpoints, then point this at it.
#
#   pip install MetaTrader5
#   # bridge.py must expose:
#   #   POST /connect   {login, password, server, terminal}
#   #   GET  /account
#   #   GET  /positions
#   #   POST /order     {symbol, side, volume, type, price, sl, tp}
# #   POST /disconnect
# ============================================================
MT5_BRIDGE_URL=http://localhost:5001
MT5_BRIDGE_TOKEN=

# ============================================================
# Exness
# ------------------------------------------------------------
# Exness trading is normally reached through MT5 (see above).
# If your account is enabled for the Exness partner / REST API,
# set the base URL and key issued to you.
# ============================================================
EXNESS_API_BASE=
EXNESS_API_KEY=
EXNESS_API_SECRET=

# ============================================================
# Deriv
# ------------------------------------------------------------
# Deriv's public WebSocket API. Create an app at
# https://app.deriv.com/account/api-token and register an app id.
# The API token must have the `trade` scope for order placement.
# ============================================================
DERIV_APP_ID=1089
DERIV_API_URL=wss://ws.derivws.com/websockets/v3

# --- safety ---
# When true, /order NEVER reaches a broker — every order is echoed
# back as a dry run. Keep this true until you have tested end to end.
DRY_RUN=true

# Set to "live" to allow real order placement. Anything else keeps
# the bridge in demo/dry-run behaviour.
TRADING_MODE=demo
