# Local backend. Keep this service on 127.0.0.1; do not expose it publicly.
PORT=8787
ALLOWED_ORIGINS=http://localhost:8090,http://127.0.0.1:8090

# Keep this in dry-run mode while setting up. Live routing requires BOTH
# DRY_RUN=false and TRADING_MODE=live.
DRY_RUN=true
TRADING_MODE=demo

# Optional local MetaTrader 5 Python bridge.
MT5_BRIDGE_URL=http://127.0.0.1:5001
MT5_BRIDGE_TOKEN=

# Optional custom Exness REST integration. Most retail Exness accounts use MT5.
EXNESS_API_BASE=

# Deriv application ID and WebSocket endpoint.
DERIV_APP_ID=1089
DERIV_API_URL=wss://ws.derivws.com/websockets/v3
