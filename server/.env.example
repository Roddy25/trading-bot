# Local backend. Keep this service on 127.0.0.1; do not expose it publicly.
PORT=8787
ALLOWED_ORIGINS=http://localhost:8090,http://127.0.0.1:8090

# Keep dry run enabled while setting up. Actual orders require a verified
# matching broker account and a positive MAX_ORDER_VOLUME limit.
DRY_RUN=true
TRADING_MODE=demo
ALLOW_LIVE_TRADING=false
# Per-order limit in the selected broker's volume unit (Deriv stake = account currency).
# Zero leaves execution blocked until you choose an appropriate cap.
MAX_ORDER_VOLUME=0

# Optional local MetaTrader 5 Python bridge.
MT5_BRIDGE_URL=http://127.0.0.1:5001
MT5_BRIDGE_TOKEN=

# Optional custom Exness REST integration. Most retail Exness accounts use MT5.
EXNESS_API_BASE=

# Deriv application ID and WebSocket endpoint.
DERIV_APP_ID=1089
DERIV_API_URL=wss://ws.derivws.com/websockets/v3
