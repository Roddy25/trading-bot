# =============================================================================
# Deriv Volatility Bot — environment template
# =============================================================================
# Copy this file to `.env` and fill in your own values:
#
#     cp .env.example .env
#     chmod 600 .env
#
# `.env` is git-ignored. NEVER commit it. NEVER paste a real token into source
# code, a chat window, a screenshot, or a support ticket.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. CREDENTIALS  (required)
# -----------------------------------------------------------------------------
# Your Deriv application ID. Create one at https://developers.deriv.com
# -> Dashboard -> Register a new application -> choose the "PAT" type.
# The legacy app_id 1089 is NOT accepted by the new API.
DERIV_APP_ID=34V4n1SQNiqq4rWQZ3ikv

# A Personal Access Token (PAT) associated with the account selected below.
# Create it in the Deriv dashboard -> API tokens -> New token.
# Required scopes:  trade   (and  account_manage  only if you want the bot to
# create accounts; the bot never needs it).
# The account type must match ACCOUNT_MODE.
DERIV_API_TOKEN=pat_6b41b81b826b94e45bee18e77c775122b1cd5525e7ea9bd832dd07ecd377a928

# -----------------------------------------------------------------------------
# 2. SAFETY  (do not change casually)
# -----------------------------------------------------------------------------
# Demo is the default. Set to "real" only when you intend to trade with
# real money; the client verifies the selected account and OTP endpoint.
# Configure strict risk limits before enabling live mode.
ACCOUNT_MODE=demo

# -----------------------------------------------------------------------------
# 3. TRADING PARAMETERS
# -----------------------------------------------------------------------------
# Contract type. Rise/Fall = CALL (rise) / PUT (fall).
CONTRACT_TYPE=CALL

# Fallback expiry. With AI_BRAIN_ENABLED=true, the learner may select a
# validated 1, 2, 3, or 5 minute duration per market.
DURATION=1
DURATION_UNIT=m

# Base stake per trade, in account currency. Martingale stays off unless
# explicitly enabled below. The risk manager checks every approved amount.
STAKE=1.0

# Fixed stake for Boom/Crash multiplier trades. Martingale never applies
# to these markets; every Boom/Crash entry uses exactly this amount.
BOOM_CRASH_STAKE=20.0

# Loss-recovery progression. Disabled by default. After settled losses the
# stake doubles every loss (uncapped). A win resets the loss streak.
MARTINGALE_ENABLED=false
MARTINGALE_MULTIPLIER=2.0
MARTINGALE_MAX_STEPS=2
MARTINGALE_MAX_STAKE=4.0

# Account currency. Must match the account.
CURRENCY=USD

# -----------------------------------------------------------------------------
# 4. RISK LIMITS
# -----------------------------------------------------------------------------
# Maximum simultaneously open contracts (1–5). Higher values increase total
# exposure; start with 2 or 3 and retain the daily loss limit.
MAX_OPEN_CONTRACTS=3

# Stop after this many consecutive losses. 0 disables this stop.
MAX_CONSECUTIVE_LOSSES=3

# Stop for the rest of the trading day once realised loss reaches this amount.
DAILY_LOSS_LIMIT=5.0

# Pause new trades for the day once realised profit reaches this amount.
# Set to 0 to disable the daily take-profit target.
DAILY_PROFIT_TARGET=0

# Minimum seconds between two entries.
COOLDOWN_SECONDS=0

# Maximum entries per trading day. 0 disables this entry-count cap.
MAX_TRADES_PER_DAY=0

# After the consecutive-loss stop trips, the bot pauses for this many minutes
# before it will consider trading again. Set to 0 to require a manual reset.
LOSS_COOLDOWN_MINUTES=60

# Timezone used to define the "trading day" boundary for the daily loss limit
# and the daily trade counter. The day rolls over at local midnight in this
# zone. Use an IANA name, e.g. Europe/London, America/New_York, UTC.
TRADING_DAY_TIMEZONE=UTC

# -----------------------------------------------------------------------------
# 5. MARKETS
# -----------------------------------------------------------------------------
# The scanner automatically discovers active Deriv synthetic-index markets
# and rotates through them five at a time. Legacy ENABLED_INDICES values, if
# present in an older .env, are ignored by the all-markets scanner.

# -----------------------------------------------------------------------------
# 6. STRATEGY
# -----------------------------------------------------------------------------
# trend = existing trend-confluence strategy (default)
# grid  = single-entry mean-reversion signals near sideways-range edges
# dca   = single-entry trend-pullback signals; does not add to open positions
DERIV_STRATEGY_MODE=trend

# EMA periods for trend structure.
EMA_FAST=20
EMA_MID=50
EMA_SLOW=200

# RSI period and the momentum band. A long needs RSI inside [RSI_MIN, RSI_MAX].
RSI_PERIOD=14
RSI_MIN=50
RSI_MAX=70

# Support/resistance lookback (number of candles each side).
SR_LOOKBACK=50
# How close (as a fraction of ATR) price must come to a level to count as a test.
SR_PROXIMITY_ATR=0.5

# Minimum signal score (0-100) required to trade.
MIN_SIGNAL_SCORE=60

# Require the 1h trend to agree with the 5m/1m signal.
REQUIRE_HTF_CONFIRMATION=true

# Require a candlestick confirmation pattern.
REQUIRE_CANDLE_CONFIRMATION=true

# Seconds between full scans of all enabled indices.
SCAN_INTERVAL_SECONDS=15

# Adaptive AI brain: studies settled trades, tunes score/RSI profiles,
# and researches expiry durations per market. It cannot bypass risk limits or
# change stake. Disable with false.
AI_BRAIN_ENABLED=true

# Optional OpenAI API advisor: ranks only strategy-approved signals.
# The local strategy and RiskManager remain the execution/risk authority.
# Create an API key separately; this is not the same as a ChatGPT subscription.
OPENAI_API_KEY=
OPENAI_ADVISOR_ENABLED=false
OPENAI_MODEL=gpt-6-luna
OPENAI_TIMEOUT_SECONDS=6
OPENAI_MIN_INTERVAL_SECONDS=30

# -----------------------------------------------------------------------------
# 7. STORAGE / LOGGING
# -----------------------------------------------------------------------------
# SQLite database path (relative to the project root).
DB_PATH=data/bot.db

# CSV trade log path.
CSV_PATH=data/trades.csv

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Log file path. Leave empty to log to the terminal only.
LOG_FILE=data/bot.log
